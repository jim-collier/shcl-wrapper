## Tool versions the pipeline was last checked with. cicd.bash warns when the
## box has something else, so a lint result that changed can be traced to the
## tool rather than the code. Rust is pinned by source/rust/rust-toolchain.toml.
PIN_GO="go1.26.2"
PIN_STATICCHECK="2026.1"
PIN_SHELLCHECK="0.11.0"
PIN_RUFF="0.15.22"
PIN_GCC="14.2.0"
PIN_GCC15="15.2.0"
PIN_CLANG_FORMAT="21.1.8"
PIN_CLANG_TIDY="22.1.8"
